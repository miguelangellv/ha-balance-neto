# Variables compartidas por todos los workflows del proyecto
# Nota: GitHub no permite usar variables en `on:` ni en el `if:` de un job.
# Si cambias MAIN_BRANCH o RELEASE_LABEL, actualiza también esos valores
# literales en los workflows.
PROJECT_NAME='Balance Neto'
INTEGRATION_DOMAIN=balance_neto
INTEGRATION_DIR=custom_components/balance_neto
MANIFEST_PATH=custom_components/balance_neto/manifest.json
PYPROJECT_PATH=pyproject.toml
MAIN_BRANCH=main
RELEASE_LABEL=release
RELEASE_BRANCH_PREFIX=release/v
VERSION_PATTERN=^v[0-9]+\.[0-9]+\.[0-9]+$
DEFAULT_PYTHON=3.14
